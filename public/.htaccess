# =========================================================================
# Sprynt40 — Apache configuration for the built React SPA (dist/)
# Drop the entire dist/ folder into your web root (public_html / htdocs).
# =========================================================================

# --- 1. SPA routing ------------------------------------------------------
# React Router owns every URL. If the request isn't a real file or folder,
# hand it to index.html so the router can handle it.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS (uncomment once your SSL cert is live)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Skip real files / real directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else → index.html
  RewriteRule ^ index.html [L]
</IfModule>

# --- 2. Compression ------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff font/woff2 application/font-woff application/font-woff2
</IfModule>

# --- 3. Long-term caching for hashed Vite assets -------------------------
# Vite emits filenames like index-XXXXXX.js — safe to cache forever.
# Never cache index.html — it must always fetch the latest asset hashes.
<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType application/json          "access plus 0 seconds"

  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"

  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"

  ExpiresByType font/woff                 "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType application/font-woff2    "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Long cache for hashed assets in /assets
  <FilesMatch "^.*\.(js|css|png|jpe?g|webp|svg|woff2?|ico|gif|ttf|eot|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Always revalidate the HTML entry
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # --- 4. Security headers ---------------------------------------------
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  Header unset X-Powered-By
</IfModule>

# --- 5. Correct MIME types (three.js / modern web) -----------------------
<IfModule mod_mime.c>
  AddType application/javascript          .js .mjs
  AddType application/wasm                .wasm
  AddType image/svg+xml                   .svg .svgz
  AddType image/webp                      .webp
  AddType font/woff                       .woff
  AddType font/woff2                      .woff2
  AddType application/manifest+json       .webmanifest
</IfModule>

# --- 6. Hardening --------------------------------------------------------
# No directory listings.
Options -Indexes

# Block access to hidden files and sensitive dot-files.
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>

# Custom 404 → let React Router render its own not-found (falls through the SPA rewrite above)
ErrorDocument 404 /index.html
